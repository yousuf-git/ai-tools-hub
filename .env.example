# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Appwrite Authentication — see AUTH_SETUP.md for how to obtain these values.
# ---------------------------------------------------------------------------

# Appwrite API endpoint (Cloud default shown; self-hosted uses your own URL).
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# Your Appwrite project ID (Appwrite Console → Project Settings).
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id

# Server-side API key (Console → Overview → Integrations → API Keys).
# Scopes required: sessions.write, users.read, users.write. Keep this SECRET.
APPWRITE_API_KEY=your_server_api_key

# Absolute URL of this app — used to build links inside verification /
# password-reset emails. In local dev use http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
